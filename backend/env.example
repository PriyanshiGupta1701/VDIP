# ==============================
# CLOUDINARY (annotated image hosting)
# ==============================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ==============================
# GOOGLE GEMINI (repair guides, search queries, price summaries)
# ==============================
GOOGLE_API_KEY=your_gemini_api_key
GOOGLE_GEMINI_MODEL=gemini-2.0-flash

# ==============================
# GOOGLE CUSTOM SEARCH (replacement-part links)
# ==============================
GOOGLE_SEARCH_API_KEY=your_google_search_api_key
GOOGLE_CSE_ID=your_custom_search_engine_id

# ==============================
# EMAIL (report link via SMTP)
# ==============================
EMAIL_SENDER=your_email@example.com
EMAIL_PASSWORD=your_email_password_or_app_password
EMAIL_SMTP_SERVER=smtp.office365.com
EMAIL_SMTP_PORT=587

# ==============================
# GOOGLE SHEETS (report destination)
# Share this sheet with your service account's email.
# ==============================
SPREADSHEET_ID=your_google_spreadsheet_id
